import { createClient } from '@supabase/supabase-js';

const supabaseUrl = process.env.SUPABASE_URL || '';
const supabaseServiceKey = process.env.SUPABASE_SERVICE_ROLE_KEY || '';
const supabase = createClient(supabaseUrl, supabaseServiceKey);

export default async function handler(req, res) {
  if (req.method !== 'POST') return res.status(405).json({ error: 'Method not allowed. Use POST.' });

  const { skillName, description, sourceCode, inputSchema } = req.body;

  if (!skillName || !description || !sourceCode || !inputSchema) {
    return res.status(400).json({ error: 'Missing required fields.' });
  }

  try {
    const sanitizedName = skillName.toLowerCase().replace(/[^a-z0-9_]/g, '_');
    
    const { data, error } = await supabase
      .from('agent_dynamic_skills')
      .upsert({
          name: sanitizedName, 
          description, 
          runtime: 'javascript', 
          source_code: sourceCode,
          input_schema: inputSchema, 
          status: 'verified', 
          created_at: new Date().toISOString()
        }, { onConflict: 'name' }
      ).select().single();

    if (error) return res.status(500).json({ success: false, error: error.message });

    await supabase.from('agent_procedural_memory').insert({
      task_pattern: `Execute dynamically synthesized skill: ${sanitizedName}`,
      steps: [
        { step: 1, action: 'Lookup skill in agent_dynamic_skills', name: sanitizedName },
        { step: 2, action: 'Execute in isolated sandbox runner via /api/skills/execute' }
      ],
      success_rate: 1.0, 
      times_executed: 1
    });

    return res.status(200).json({ success: true, skill: data });
  } catch (err) {
    return res.status(500).json({ success: false, error: err.message });
  }
}
