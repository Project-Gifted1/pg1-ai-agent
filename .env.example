# PG1 Sovereign AI Agent - Environment Configuration

# Google Gemini API Key (Used for complex reasoning, refactoring, code, deep analysis)
# Get key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# OpenRouter API Key (Used for fast responses via deepseek/deepseek-chat)
# Get key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# AWS Polly Voice Generation (FREE)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1

# Voice Configuration
PG1_VOICE_PROVIDER=amazon-polly
PG1_DEFAULT_VOICE=Joanna
PG1_VOICE_FORMAT=mp3
PG1_VOICE_RATE=22050
PG1_VOICE_CACHE_ENABLED=true
PG1_VOICE_CACHE_DIR=./cache/voices

# Voice Contexts (Map to AWS voices)
PG1_VOICE_PROFESSIONAL_MALE=Matthew
PG1_VOICE_PROFESSIONAL_FEMALE=Joanna
PG1_VOICE_FRIENDLY_MALE=Joey
PG1_VOICE_FRIENDLY_FEMALE=Amy
PG1_VOICE_TECHNICAL_MALE=Brian
PG1_VOICE_TECHNICAL_FEMALE=Ivy
PG1_VOICE_LUXURY_MALE=Geraint
PG1_VOICE_LUXURY_FEMALE=Aditi

# Threat data source switches (lib/sourcePolicy.mjs). abuse.ch and
# unattributed rows are off unless set to true; every other source is on
# unless set to false.
SOURCE_ABUSECH_ENABLED=false
SOURCE_UNATTRIBUTED_ENABLED=false

# PG1 Motion video clips (/video [draft|pro] [short|long], "make a video of...";
# lib/videoJobs.mjs). Off unless PG1_VIDEO_ENABLED=1. A daily estimated-spend
# budget in USD (a failed clip still counts), a hard clip limit and the model,
# defaults shown. Not Veo: its previews shut down on 2026-10-22.
PG1_VIDEO_ENABLED=0
PG1_VIDEO_DAILY_BUDGET_USD=5.00
PG1_VIDEO_DAILY_CAP=10
PG1_VIDEO_MODEL=gemini-omni-1.1-flash
# The clip is rendered synchronously by api/video-render.mjs (Google's GET
# /interactions/{id} is broken since 2026-10-03). The chat triggers it with
# an HMAC token signed with this secret (16+ characters; CRON_SECRET is used
# when it is unset). PG1_VIDEO_RENDER_URL overrides where the trigger goes
# (default: the production domain, or this deployment's VERCEL_URL).
# PG1_VIDEO_GOOGLE_ASYNC=1 goes back to the background job + GET poll.
PG1_VIDEO_RENDER_SECRET=
PG1_VIDEO_RENDER_URL=
PG1_VIDEO_GOOGLE_ASYNC=0
# Replicate fallback for video (same REPLICATE_API_TOKEN as /image). Clips with
# a starting frame: kwaivgi/kling-v2.1 by default. Text-only clips: unset means
# no Replicate fallback (Kling v2.1 needs a start image).
PG1_VIDEO_MODEL_REPLICATE_IMAGE=kwaivgi/kling-v2.1
PG1_VIDEO_MODEL_REPLICATE=
# PG1 Studio (/film, lib/film/*): multi-shot films of a minute or more, on
# the same switch (PG1_VIDEO_ENABLED) and render secret as PG1 Motion. The
# chat dispatches .github/workflows/film-render.yml with GITHUB_TOKEN (needs
# Actions: write on PG1_FILM_RENDER_REPO); the workflow reads its own copies
# of SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, REPLICATE_API_TOKEN,
# ANTHROPIC_API_KEY, CARTESIA_API_KEY and PG1_VIDEO_RENDER_SECRET from the
# repository's Actions secrets. PG1_FILM_MAX_USD is the per-film spending cap.
# /film sync-secrets (operator only, approve first) copies this deployment's
# PG1_VIDEO_RENDER_SECRET, SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY,
# REPLICATE_API_TOKEN and CARTESIA_API_KEY into those Actions secrets with
# PG1_FILM_GITHUB_TOKEN only (fine-grained, this repo, Secrets: read and
# write). ANTHROPIC_API_KEY is never copied; set it in GitHub by hand.
PG1_FILM_MAX_USD=20
PG1_FILM_GITHUB_TOKEN=
PG1_FILM_RENDER_REPO=Project-Gifted1/pg1-ai-agent
PG1_FILM_RENDER_REF=main
PG1_FILM_STILL_MODEL=black-forest-labs/flux-kontext-pro
PG1_FILM_MUSIC_MODEL=google/lyria-2
PG1_FILM_CLAUDE_MODEL=claude-opus-5-5
PG1_FILM_VOICE_ID=
PG1_FILM_CONCURRENCY=3

# Vercel cron (vercel.json "crons": /api/heartbeat/pulse, /api/errors/cleanup).
# Required: both routes answer 403 while it is unset. Vercel sends it on
# every cron run as "Authorization: Bearer <CRON_SECRET>". 16+ random chars.
CRON_SECRET=
