# PG1 Sovereign AI Agent - Environment Configuration

# Google Gemini API Key (Used for complex reasoning, refactoring, code, deep analysis)
# Get key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# OpenRouter API Key (Used for fast responses via deepseek/deepseek-chat)
# Get key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Static frontend origin routing / API hardening
PG1_BACKEND_ORIGIN=https://pg1-ai-agent.vercel.app
ALLOWED_ORIGINS=https://project-gifted1.github.io,https://pg1-ai-agent.vercel.app,http://localhost:3000,http://localhost:5173
MAX_MESSAGE_LENGTH=5000

# AWS Polly Voice Generation (FREE)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1

# Voice Configuration
PG1_VOICE_PROVIDER=amazon-polly
PG1_DEFAULT_VOICE=Joanna
PG1_VOICE_FORMAT=mp3
PG1_VOICE_RATE=22050
PG1_VOICE_CACHE_ENABLED=true
PG1_VOICE_CACHE_DIR=./cache/voices

# Voice Contexts (Map to AWS voices)
PG1_VOICE_PROFESSIONAL_MALE=Matthew
PG1_VOICE_PROFESSIONAL_FEMALE=Joanna
PG1_VOICE_FRIENDLY_MALE=Joey
PG1_VOICE_FRIENDLY_FEMALE=Amy
PG1_VOICE_TECHNICAL_MALE=Brian
PG1_VOICE_TECHNICAL_FEMALE=Ivy
PG1_VOICE_LUXURY_MALE=Geraint
PG1_VOICE_LUXURY_FEMALE=Aditi
