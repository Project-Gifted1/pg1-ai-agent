# PG1 Sovereign AI Agent - Environment Configuration

# Google Gemini API Key (Used for complex reasoning, refactoring, code, deep analysis)
# Get key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# OpenRouter API Key (Used for fast responses via deepseek/deepseek-chat)
# Get key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# AWS Polly Voice Generation (FREE)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1

# Voice Configuration
PG1_VOICE_PROVIDER=amazon-polly
PG1_DEFAULT_VOICE=Joanna
PG1_VOICE_FORMAT=mp3
PG1_VOICE_RATE=22050
PG1_VOICE_CACHE_ENABLED=true
PG1_VOICE_CACHE_DIR=./cache/voices

# Voice Contexts (Map to AWS voices)
PG1_VOICE_PROFESSIONAL_MALE=Matthew
PG1_VOICE_PROFESSIONAL_FEMALE=Joanna
PG1_VOICE_FRIENDLY_MALE=Joey
PG1_VOICE_FRIENDLY_FEMALE=Amy
PG1_VOICE_TECHNICAL_MALE=Brian
PG1_VOICE_TECHNICAL_FEMALE=Ivy
PG1_VOICE_LUXURY_MALE=Geraint
PG1_VOICE_LUXURY_FEMALE=Aditi

# Threat data source switches (lib/sourcePolicy.mjs). abuse.ch, OTX,
# AbuseIPDB and unattributed rows are locked off (these variables are
# ignored). NVD is on. Blocklist.de, PG1-Swarm, ScamSniffer and any other
# label are off until their terms are confirmed for commercial resale.
SOURCE_BLOCKLIST_DE_ENABLED=false
SOURCE_PG1_SWARM_ENABLED=false
SOURCE_SCAMSNIFFER_ENABLED=false
SOURCE_OTHER_ENABLED=false

# PG1 Motion video clips (/video [draft|pro] [short|long], "make a video of...";
# lib/videoJobs.mjs). Off unless PG1_VIDEO_ENABLED=1. A daily estimated-spend
# budget in USD (a failed clip still counts), a hard clip limit and the model,
# defaults shown. Not Veo: its previews shut down on 2026-10-22.
PG1_VIDEO_ENABLED=0
PG1_VIDEO_DAILY_BUDGET_USD=5.00
PG1_VIDEO_DAILY_CAP=10
PG1_VIDEO_MODEL=gemini-omni-1.1-flash
# The clip is rendered synchronously by api/video-render.mjs (Google's GET
# /interactions/{id} is broken since 2026-10-03). The chat triggers it with
# an HMAC token signed with this secret (16+ characters; CRON_SECRET is used
# when it is unset). PG1_VIDEO_RENDER_URL overrides where the trigger goes
# (default: the production domain, or this deployment's VERCEL_URL).
# PG1_VIDEO_GOOGLE_ASYNC=1 goes back to the background job + GET poll.
PG1_VIDEO_RENDER_SECRET=
PG1_VIDEO_RENDER_URL=
PG1_VIDEO_GOOGLE_ASYNC=0
# Replicate fallback for video (same REPLICATE_API_TOKEN as /image). Clips with
# a starting frame: kwaivgi/kling-v2.1 by default. Text-only clips: unset means
# no Replicate fallback (Kling v2.1 needs a start image).
PG1_VIDEO_MODEL_REPLICATE_IMAGE=kwaivgi/kling-v2.1
PG1_VIDEO_MODEL_REPLICATE=
# PG1 Studio (/film, lib/film/*): multi-shot films of a minute or more, on
# the same switch (PG1_VIDEO_ENABLED) and render secret as PG1 Motion. The
# chat dispatches .github/workflows/film-render.yml with GITHUB_TOKEN (needs
# Actions: write on PG1_FILM_RENDER_REPO); the workflow reads its own copies
# of SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, REPLICATE_API_TOKEN,
# ANTHROPIC_API_KEY, CARTESIA_API_KEY and PG1_VIDEO_RENDER_SECRET from the
# repository's Actions secrets. PG1_FILM_MAX_USD is the per-film spending cap.
# /film sync-secrets (operator only, approve first) copies this deployment's
# PG1_VIDEO_RENDER_SECRET, SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY,
# REPLICATE_API_TOKEN and CARTESIA_API_KEY into those Actions secrets with
# PG1_FILM_GITHUB_TOKEN only (fine-grained, this repo, Secrets: read and
# write). ANTHROPIC_API_KEY is never copied; set it in GitHub by hand.
PG1_FILM_MAX_USD=20
PG1_FILM_GITHUB_TOKEN=
PG1_FILM_RENDER_REPO=Project-Gifted1/pg1-ai-agent
PG1_FILM_RENDER_REF=main
PG1_FILM_STILL_MODEL=black-forest-labs/flux-kontext-pro
PG1_FILM_MUSIC_MODEL=google/lyria-2
PG1_FILM_CLAUDE_MODEL=claude-opus-5-5
PG1_FILM_VOICE_ID=
PG1_FILM_CONCURRENCY=3

# Vercel cron (vercel.json "crons": /api/heartbeat/pulse, /api/errors/cleanup).
# Required: both routes answer 403 while it is unset. Vercel sends it on
# every cron run as "Authorization: Bearer <CRON_SECRET>". 16+ random chars.
CRON_SECRET=

# Chat context and task focus (lib/taskState.mjs, lib/contextWindow.mjs).
# The newest turns kept verbatim in the chat prompt, in tokens (default
# 3000); older turns are folded into a rolling summary. The task-state and
# summary updates use the free Gemini key (GEMINI_API_KEY_FREE) for the
# operator's own turns only; PG1_CHEAP_GEMINI_MODEL picks the model.
PG1_CONTEXT_RECENT_TOKENS=3000
PG1_CHEAP_GEMINI_MODEL=gemini-3.6-flash

# PDFs (lib/pdf): page limit per PDF (default 50) and how long the
# operator's documents stay in the media library (default 90 days; A2A job
# outputs are kept 7). The file size limit is PG1_STORAGE_MAX_MB (default 48).
PG1_PDF_MAX_PAGES=50
PG1_PDF_RETENTION_DAYS=90

# PG1 lab (docs/lab.md): experiments run on .github/workflows/lab.yml with
# lab-only keys. PG1_LAB_DISPATCH_SECRET must equal the "lab" environment's
# secret of the same name in GitHub. Budgets in USD: per experiment and per
# UTC day (defaults 2 and 5). GITHUB_TOKEN (Actions: read and write)
# dispatches and reads the runs; PG1_LAB_DISPATCH_GITHUB_TOKEN overrides it.
PG1_LAB_DISPATCH_SECRET=
PG1_LAB_BUDGET_USD=2
PG1_LAB_DAILY_USD=5
PG1_LAB_DISPATCH_GITHUB_TOKEN=

# Autonomy kill switch (lib/autonomy.mjs): off | lab | on (default lab).
# off: PG1 takes no autonomous action (the lab, the cheap-model task
# updates and skill suggestions stop; retention and flag auto-disable still
# run). lab: autonomous work only in the lab and as drafts. on: free actions
# anywhere. Payments, publishing, pricing, merges, new data sources and
# contacting people always need the operator; policy and budget changes are
# never allowed. /autonomy shows the last 24 hours of the audit log.
PG1_AUTONOMY=lab

# A2A jobs (lib/a2aJobs): per-wallet jobs per hour (default 5; 2 running at
# once per wallet), jobs running at once across all agents (default 3; busy
# answers 503 with Retry-After), and media jobs (off; none are offered).
PG1_A2A_JOBS_PER_HOUR=5
PG1_A2A_MAX_JOBS=3
PG1_A2A_MEDIA=false

# Signed results (lib/signing.mjs): the Ed25519 private key as a base64url
# 32-byte seed (make one with: node scripts/signing-key.mjs). Mark it
# Sensitive in Vercel. Without it nothing is signed and the JWKS at
# /.well-known/pg1-signing-key is empty. PG1_SIGNING_KEY_ID names the key
# (default: derived from the public key). To rotate: put the old public JWK
# into PG1_SIGNING_PREVIOUS_JWKS (a JSON array), then set the new key.
PG1_SIGNING_KEY=
PG1_SIGNING_KEY_ID=
PG1_SIGNING_PREVIOUS_JWKS=[]

# Short-TTL cache of completed check_x402_endpoint/check_agent_card results
# (lib/resultCache.mjs), in ms. Only no_flags/flagged are cached.
PG1_RESULT_CACHE_TTL_MS=300000

# Watchlists (lib/watchlists.mjs): the master key every watchlist's webhook
# secret is derived from (at least 32 characters; Sensitive). Without it,
# POST /api/watchlists answers 503. Changing it invalidates every secret.
PG1_WATCHLIST_SECRET=

# Proprietary signals (lib/signals.mjs, docs/signals-design.md): design only.
# Keep off until the privacy notice and terms changes are reviewed.
PG1_SIGNALS=off
