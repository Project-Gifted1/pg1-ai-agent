# PG1 Sovereign AI Agent - Environment Configuration

# Google Gemini API Key (Used for complex reasoning, refactoring, code, deep analysis)
# Get key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# OpenRouter API Key (Used for fast responses via deepseek/deepseek-chat)
# Get key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Supabase (Required for persistent enterprise agent data; runtime falls back to in-memory if omitted)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Security and control-plane settings
ALLOWED_ORIGINS=https://pg1-ai-agent.vercel.app,http://localhost:3000
AGENT_ALLOWED_ORIGINS=https://pg1-ai-agent.vercel.app,http://localhost:3000
MAX_MESSAGE_LENGTH=5000
