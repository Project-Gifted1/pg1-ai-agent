          },
          "test_fixture": {
            "type": "boolean",
            "description": "true only when the input was a documented integration test fixture and this response is canned; absent on real results."
          }
        },
        "required": [
          "address",
          "chain",
          "found",
          "first_seen",
          "age_days",
          "first_seen_block",
          "first_direction",
          "is_contract",
          "source",
          "cached"
        ]
