    "/api/repo-trap": {
      "post": {
        "operationId": "checkRepoTrap",
        "summary": "Check a downloaded project's file listing for the untrusted repo trap (free)",
        "security": [],
        "description": "The REST mirror of the check_repo_trap MCP tool and A2A skill. Send the listing you already have; PG1 never fetches a URL and never unpacks, decodes, imports or runs anything from the project. Deterministic rules, no AI model. Nothing is stored: only the verdict and reason codes are logged. Always free, 60 calls/hour per caller (a Gumroad licence key in x-api-key lifts the limit). The result is signed (Ed25519) in a top-level signature. no_findings does not prove a project is harmless.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "files"
                ],
                "additionalProperties": false,
                "properties": {
                  "files": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 2000,
                    "items": {
                      "type": "object",
                      "required": [
                        "path"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "path": {
                          "type": "string",
                          "maxLength": 512,
                          "description": "Path relative to the project root."
                        },
                        "size": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "executable": {
                          "type": "boolean",
                          "description": "Whether the file has the executable bit."
                        },
                        "magic_hex": {
                          "type": "string",
                          "maxLength": 64,
                          "pattern": "^([0-9a-fA-F]{2}){1,32}$",
                          "description": "The file's first bytes as hex."
                        },
                        "text": {
                          "type": "string",
                          "description": "The start of a text file, up to 16384 bytes of UTF-8 (262144 bytes per request in all)."
                        }
                      }
                    }
                  },
                  "name": {
                    "type": "string",
                    "maxLength": 200,
                    "description": "Optional label, echoed back."
                  }
                }
              },
              "example": {
                "files": [
                  {
                    "path": "README.md",
                    "text": "# Records\nWrite your own Python decoder to parse records.bin.\n"
                  },
                  {
                    "path": "decoder",
                    "size": 81234,
                    "executable": true,
                    "magic_hex": "cffaedfe07000001"
                  },
                  {
                    "path": "records.bin",
                    "size": 40960,
                    "magic_hex": "789c"
                  },
                  {
                    "path": "struct.py",
                    "size": 1400
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The verdict, findings and advice.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "verdict",
                    "risk",
                    "summary",
                    "files_checked",
                    "findings",
                    "advice"
                  ],
                  "properties": {
                    "verdict": {
                      "type": "string",
                      "enum": [
                        "no_findings",
                        "suspicious",
                        "malicious"
                      ]
                    },
                    "risk": {
                      "type": "string",
                      "enum": [
                        "none",
                        "medium",
                        "high"
                      ]
                    },
                    "summary": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "files_checked": {
                      "type": "integer"
                    },
                    "text_bytes_checked": {
                      "type": "integer"
                    },
                    "findings": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "code",
                          "severity",
                          "paths"
                        ],
                        "properties": {
                          "code": {
                            "type": "string",
                            "enum": [
                              "STDLIB_SHADOW",
                              "PY_STARTUP_HOOK",
                              "NODE_INSTALL_HOOK",
                              "UNTRUSTED_BINARY",
                              "ENCODED_PAYLOAD",
                              "DECODER_BAIT",
                              "SECRET_PATH_REFERENCE",
                              "PERSISTENCE_HINT"
                            ]
                          },
                          "severity": {
                            "type": "string",
                            "enum": [
                              "high",
                              "medium"
                            ]
                          },
                          "paths": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "paths_truncated": {
                            "type": "boolean"
                          },
                          "detail": {
                            "type": [
                              "string",
                              "null"
                            ]
                          }
                        }
                      }
                    },
                    "advice": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "not_inspected": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "rules_version": {
                      "type": "string"
                    },
                    "note": {
                      "type": "string"
                    },
                    "reasons": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "code": {
                            "type": "string"
                          },
                          "message": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "flagged",
                        "no_flags",
                        "unknown"
                      ]
                    },
                    "checks": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "request_id": {
                      "type": "string"
                    },
                    "signature": {
                      "type": "object",
                      "description": "Ed25519 signature block; keys at /.well-known/pg1-signing-key."
                    }
                  }
                }
              }
            }
