{
  "openapi": "3.1.0",
  "info": {
    "title": "PG1 Sovereign Threat Intelligence API",
    "version": "1.22.0",
    "contact": {
      "email": "gikewun@gmail.com"
    },
    "description": "REST endpoints for PG1 Sovereign Threat Intelligence. This document only covers the plain HTTP endpoints below (GET/POST /api/ioc, POST /api/repo-trap and GET /api/health); the full tool catalog is also available over two JSON-RPC transports, which are not representable as REST paths:\n\n- MCP (Model Context Protocol, Streamable HTTP JSON-RPC): https://pg1-ai-agent.vercel.app/api/mcp \n- A2A (Agent2Agent, JSON-RPC 2.0): https://pg1-ai-agent.vercel.app/api/a2a — agent card at https://pg1-ai-agent.vercel.app/.well-known/agent-card.json \n\n/api/ioc is gated by one of: a Gumroad licence key (x-api-key header), a per-call x402 v2 micropayment (PAYMENT-SIGNATURE header), or the free tier (automatic, 5 calls/day per IP shared with the paid MCP tools and A2A skills, spent before any 402; send x-free-tier: 0 to skip it).",
    "x-guidance": "GET /api/ioc (optional query parameters since, type, min_score, limit) returns a STIX 2.1 bundle (application/stix+json) of CVE records from NIST NVD: STIX vulnerability objects with the CVE id and an NVD reference, no IP, domain, URL or file-hash indicators yet. It is free (CVE records from NIST NVD); does not use the 5 free paid calls a day (the operator's PG1_FEED_PAID switch can make it paid). The paid tools (CVE enrichment, threat actor profiles) are on the MCP server at /api/mcp: 0.01 USD per call in USDC on Base (eip155:8453) via x402, after 5 free paid calls a day. GET /api/health is free. POST /api/repo-trap (1.22.0) is free (60 calls/hour per caller): send a downloaded project's file listing before running anything from it; PG1 never fetches or runs anything from the project."
  },
  "externalDocs": {
    "description": "Integration guide: an alert bot that screens wallets with PG1's free checks.",
    "url": "https://pg1-ai-agent.vercel.app/docs/crypto-alert-bot"
  },
  "x-pg1-signing": {
    "description": "PG1 results are signed with Ed25519 (MCP result._meta[\"pg1/signature\"], A2A metadata[\"pg1.signature\"], REST the top-level signature). Each signature block carries jwks_url, and each signed response has Link: <jwks_url>; rel=\"jwks\". Pick the key by kid. Signing input and offline verifiers: docs_url.",
    "jwks_url": "https://pg1-ai-agent.vercel.app/.well-known/pg1-signing-key",
    "jwks_alias_url": "https://pg1-ai-agent.vercel.app/.well-known/jwks.json",
    "alg": "EdDSA",
    "docs_url": "https://pg1-ai-agent.vercel.app/docs/agents#verify-a-result"
  },
  "servers": [
    {
      "url": "https://pg1-ai-agent.vercel.app"
    }
  ],
  "paths": {
    "/api/ioc": {
      "get": {
        "operationId": "getThreatIndicators",
        "summary": "STIX 2.1 CVE feed (NVD)",
        "description": "Returns a STIX 2.1 bundle of CVE records from NIST NVD, the only source PG1 may currently redistribute commercially: vulnerability objects with the CVE id and an NVD reference, no scores. It holds no IP, domain, URL or file-hash indicators yet. FREE (CVE records from NIST NVD); does not use the 5 free paid calls a day; no licence key, no payment (the operator's PG1_FEED_PAID switch can make it paid).",
        "parameters": [
          {
            "name": "since",
            "in": "query",
            "required": false,
            "description": "ISO timestamp (e.g. 2026-09-20T00:00:00Z). Only records last seen after this time are returned.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "type",
            "in": "query",
            "required": false,
            "description": "Exact-match record type filter. Today the feed holds only CVE records, so any other type returns an empty bundle.",
            "schema": {
              "type": "string",
              "enum": [
                "IPv4",
                "IPv6",
                "domain",
                "hostname",
                "URL",
                "FileHash-MD5",
                "FileHash-SHA1",
                "FileHash-SHA256",
                "CVE"
              ]
            }
          },
          {
            "name": "min_score",
            "in": "query",
            "required": false,
            "description": "Minimum confidence score, inclusive.",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100,
              "default": 0
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Maximum number of STIX objects to return.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000,
              "default": 500
            }
          },
          {
            "name": "x-free-tier",
            "in": "header",
            "required": false,
            "description": "Optional. The free tier (5 calls/day per IP, shared with the paid MCP tools and A2A skills) is used automatically before any 402; set to \"0\" to skip it and get the payment challenge at once. Ignored if a licence key or payment is present.",
            "schema": {
              "type": "string",
              "enum": [
                "1"
              ]
            }
          }
        ],
        "security": [],
        "responses": {
          "200": {
            "description": "STIX 2.1 bundle of matching records (today: CVE vulnerability objects only).",
            "content": {
              "application/stix+json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "bundle"
                    },
                    "id": {
                      "type": "string",
                      "description": "STIX bundle id, bundle--<uuid>."
                    },
                    "objects": {
                      "type": "array",
                      "items": {
                        "oneOf": [
                          {
                            "type": "object",
                            "description": "STIX 2.1 Indicator (IPv4, IPv6, domain, hostname, URL and file-hash records).",
                            "properties": {
                              "type": {
                                "type": "string",
                                "const": "indicator"
                              },
                              "spec_version": {
                                "type": "string",
                                "const": "2.1"
                              },
                              "id": {
                                "type": "string"
                              },
                              "created": {
                                "type": "string",
                                "format": "date-time"
                              },
                              "modified": {
                                "type": "string",
                                "format": "date-time"
                              },
                              "name": {
                                "type": "string"
                              },
                              "description": {
                                "type": "string"
                              },
                              "indicator_types": {
                                "type": "array",
                                "items": {
                                  "type": "string"
                                }
                              },
                              "pattern": {
                                "type": "string",
                                "description": "STIX pattern, e.g. [ipv4-addr:value = '198.51.100.23']."
                              },
                              "pattern_type": {
                                "type": "string",
                                "const": "stix"
                              },
                              "valid_from": {
                                "type": "string",
                                "format": "date-time"
                              },
                              "confidence": {
                                "type": "integer",
                                "minimum": 0,
                                "maximum": 100
                              },
                              "external_references": {
                                "type": "array",
                                "items": {
                                  "type": "object",
                                  "properties": {
                                    "source_name": {
                                      "type": "string"
                                    },
                                    "description": {
                                      "type": "string"
                                    }
                                  }
                                }
                              }
                            },
                            "required": [
                              "type",
                              "spec_version",
                              "id",
                              "created",
                              "modified",
                              "pattern",
                              "pattern_type",
                              "valid_from"
                            ]
                          },
                          {
                            "type": "object",
                            "description": "STIX 2.1 Vulnerability (CVE records).",
                            "properties": {
                              "type": {
                                "type": "string",
                                "const": "vulnerability"
                              },
                              "spec_version": {
                                "type": "string",
                                "const": "2.1"
                              },
                              "id": {
                                "type": "string"
                              },
                              "created": {
                                "type": "string",
                                "format": "date-time"
                              },
                              "modified": {
                                "type": "string",
                                "format": "date-time"
                              },
                              "name": {
                                "type": "string",
                                "description": "CVE id, e.g. CVE-2026-12345."
                              },
                              "description": {
                                "type": "string"
                              },
                              "external_references": {
                                "type": "array",
                                "items": {
                                  "type": "object",
                                  "properties": {
                                    "source_name": {
                                      "type": "string"
                                    },
                                    "external_id": {
                                      "type": "string"
                                    }
                                  }
                                }
                              }
                            },
                            "required": [
                              "type",
                              "spec_version",
                              "id",
                              "created",
                              "modified",
                              "name"
                            ]
                          }
                        ]
                      }
                    }
                  },
                  "required": [
                    "type",
                    "id",
                    "objects"
                  ]
                }
              }
            }
          },
          "402": {
            "description": "Only when the operator has made the feed paid again (PG1_FEED_PAID): an x402 v2 payment challenge. While the feed is free (the default) there is no 402.",
            "headers": {
              "PAYMENT-REQUIRED": {
                "description": "Base64-encoded x402 v2 PaymentRequired JSON object. Present when the x402 middleware issues the challenge.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "type": "object",
                      "description": "x402 v2 PaymentRequired object.",
                      "properties": {
                        "x402Version": {
                          "type": "integer",
                          "const": 2
                        },
                        "error": {
                          "type": "string"
                        },
                        "resource": {
                          "type": "object",
                          "properties": {
                            "url": {
                              "type": "string"
                            },
                            "description": {
                              "type": "string"
                            },
                            "mimeType": {
                              "type": "string"
                            }
                          }
                        },
                        "accepts": {
                          "type": "array",
                          "minItems": 1,
                          "items": {
                            "type": "object",
                            "properties": {
                              "scheme": {
                                "type": "string",
                                "const": "exact"
                              },
                              "network": {
                                "type": "string",
                                "const": "eip155:8453"
                              },
                              "amount": {
                                "type": "string",
                                "description": "Price in USDC atomic units (6 decimals): \"10000\" = $0.01."
                              },
                              "asset": {
                                "type": "string",
                                "description": "USDC contract on Base."
                              },
                              "payTo": {
                                "type": "string"
                              },
                              "maxTimeoutSeconds": {
                                "type": "integer"
                              },
                              "extra": {
                                "type": "object"
                              }
                            },
                            "required": [
                              "scheme",
                              "network",
                              "amount",
                              "asset",
                              "payTo"
                            ]
                          }
                        },
                        "extensions": {
                          "type": "object"
                        }
                      },
                      "required": [
                        "x402Version",
                        "accepts"
                      ]
                    },
                    {
                      "type": "object",
                      "properties": {
                        "error": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "error"
                      ]
                    }
                  ]
                }
              }
            }
          },
          "403": {
            "description": "Forbidden: the supplied licence key is invalid, expired, or refunded.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "405": {
            "description": "Method Not Allowed. /api/ioc only serves GET, POST, HEAD, and OPTIONS.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error while building or serving the STIX bundle.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "Threat data or licence verification is temporarily unavailable; retry shortly.",
            "headers": {
              "Retry-After": {
                "description": "Present when licence verification is temporarily unavailable. Value in seconds.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      },
