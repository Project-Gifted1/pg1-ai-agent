    },
    "/api/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Health check",
        "description": "Public, ungated uptime check. Never consumes free-tier quota. Result is cached in memory for up to 30 seconds.",
        "security": [],
        "responses": {
          "200": {
            "description": "Service is healthy.",
