# 1. DYNAMIC AST-LEVEL SELF-HEALING & INSPECTION ENGINE
# ---------------------------------------------------------------------------
class ASTSelfHealingEngine:
    """Inspects and validates code syntax and runtime structures using Python AST."""

    @staticmethod
    def inspect_and_repair_source(source_code: str) -> Tuple[bool, str]:
        try:
            parsed_ast = ast.parse(source_code)
            # AST analysis for dangerous or broken nodes
            class SafetyVisitor(ast.NodeVisitor):
                def __init__(self):
                    self.valid = True
                    self.issues = []

                def visit_Exec(self, node):
                    self.valid = False
                    self.issues.append("Forbidden dynamic exec call detected")

            visitor = SafetyVisitor()
            visitor.visit(parsed_ast)
            
            if not visitor.valid:
                return False, f"AST Inspection Failed: {', '.join(visitor.issues)}"
            return True, "AST Inspection Passed: Code syntax and structure verified clean."
        except SyntaxError as se:
            return False, f"AST Syntax Error: {se}"

