# 5. ENTERPRISE STIX 2.1 & KNOWLEDGE GRAPH ENGINE
# ---------------------------------------------------------------------------
class STIX2KnowledgeGraphEngine:
    def __init__(self):
        self.graph = nx.Graph()

    def build_stix_and_graph(self, threats: List[Dict[str, Any]]) -> Tuple[Dict[str, Any], Dict[str, Any]]:
        stix_objects = []
        now_iso = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%S.%f")[:-3] + "Z"

        for threat in threats:
            val = threat["value"]
            val_type = threat.get("type", "ipv4-addr")
            malware = threat.get("malware_family", "Unknown C2")
            asn = threat.get("asn", "AS0")
            risk = threat.get("risk_score", 50)
            domain = threat.get("domain")
            ssl_hash = threat.get("ssl_cert_hash")

            # Build Knowledge Graph Nodes
            self.graph.add_node(val, type="Indicator", risk=risk)
            if domain:
                self.graph.add_node(domain, type="Domain")
                self.graph.add_edge(val, domain, relation="resolves_to")
            if ssl_hash:
                self.graph.add_node(ssl_hash, type="SSL_Cert")
                self.graph.add_edge(val, ssl_hash, relation="presents_cert")
            if malware:
                self.graph.add_node(malware, type="Malware")
                self.graph.add_edge(val, malware, relation="associated_with")

            # STIX 2.1 Indicator
            ind_id = f"indicator--{str(uuid.uuid5(uuid.NAMESPACE_DNS, val))}"
            stix_objects.append({
                "type": "indicator",
                "spec_version": STIX_VERSION,
                "id": ind_id,
                "created": now_iso,
                "modified": now_iso,
                "name": f"High-Confidence C2 Endpoint: {val}",
                "pattern": f"[{val_type}:value = '{val}']",
                "pattern_type": "stix",
                "valid_from": now_iso,
                "confidence": risk,
                "external_references": [{"source_name": "PG1 Sovereign AI Pipeline"}]
            })

        bundle = {
            "type": "bundle",
            "id": f"bundle--{str(uuid.uuid4())}",
            "objects": stix_objects
        }

        graph_summary = {
            "nodes": self.graph.number_of_nodes(),
            "edges": self.graph.number_of_edges(),
            "clusters": len(list(nx.connected_components(self.graph)))
        }

        return bundle, graph_summary

