# 2. ADVERSARIAL RED/BLUE MULTI-AGENT SWARM CONSENSUS
# ---------------------------------------------------------------------------
class AdversarialSwarmConsensus:
    """Multi-Agent Swarm Consensus enforcing rigorous adversarial filtering."""

    def __init__(self, high_risk_asns: Dict[str, str], benign_asns: Dict[str, str]):
        self.high_risk_asns = high_risk_asns
        self.benign_asns = benign_asns

    def run_red_team_attack(self, threat: Dict[str, Any]) -> List[str]:
        """Red Team Agent tries to inject bypasses, false positives, or malformed data."""
        vulnerabilities = []
        value = threat.get("value", "")
        
        # Test 1: Private IP Ingestion Attack
        if value.startswith("127.") or value.startswith("192.168.") or value.startswith("10."):
            vulnerabilities.append("RFC1918 Private IP leakage detected")
            
        # Test 2: Truncated Hash or Malformed Syntax
        if threat.get("ssl_cert_hash") and len(threat.get("ssl_cert_hash")) < 32:
            vulnerabilities.append("Malformed SSL cert hash injection")
            
        return vulnerabilities

    def run_blue_team_defense(self, threat: Dict[str, Any]) -> Dict[str, Any]:
        """Blue Team Agent enriches, sanitizes, and verifies ASN reputation."""
        asn = threat.get("asn", "AS0")
        raw_score = threat.get("risk_score", 50)
        
        if asn in self.high_risk_asns:
            threat["risk_score"] = min(100, raw_score + 35)
            threat["risk_classification"] = "CRITICAL (Bulletproof Hosting Approved)"
        elif asn in self.benign_asns:
            threat["risk_score"] = max(10, raw_score - 50)
            threat["risk_classification"] = "SUPPRESSED (Benign Public Infrastructure)"
        else:
            threat["risk_classification"] = "VERIFIED THREAT NODE"
            
        return threat

    def execute_swarm_consensus(self, raw_feed: List[Dict[str, Any]]) -> List[Dict[str, Any]]:
        approved_threats = []
        for item in raw_feed:
            # Step A: Red Team Infiltration Attempt
            red_issues = self.run_red_team_attack(item)
            if red_issues:
                print(f" [Swarm Red-Team Rejected] {item.get('value')}: {', '.join(red_issues)}")
                continue

            # Step B: Blue Team Verification & Scoring
            verified_item = self.run_blue_team_defense(item)

            # Step C: Consensus Oracle Decision
            if verified_item["risk_score"] >= 30:
                approved_threats.append(verified_item)
                print(f" [Swarm Consensus Approved] {verified_item['value']} | Score: {verified_item['risk_score']} | Class: {verified_item['risk_classification']}")
            else:
                print(f" [Swarm Suppressed] {verified_item['value']} (Benign CDN score: {verified_item['risk_score']})")

        return approved_threats

